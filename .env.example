# Copy to `.env` for local development: `cp .env.example .env`.
# Naming rules: docs/adr/0002-settings-management.md

# Common (src/app/libs/settings/common.py)
# dev | sit | uat | prod
DEPLOYMENT_ENV=dev
DEBUG=false
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_DATABASE=app
REDIS_HOST=localhost
REDIS_PORT=6379

# API (API_*, src/app/apps/api_service/core/settings.py)
# API_VERSION=0.1.0
# API_ROOT_PATH=

# "a.com,b.com,a.b.com"
API_CORS_ALLOW_ORIGINS=http://localhost:3000

# Worker (WORKER_*, src/app/apps/worker/settings.py)
# none yet
